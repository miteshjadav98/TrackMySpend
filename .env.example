# Copy to .env and adjust. Every variable maps to a field in backend/src/finance_core/config.py.

ENVIRONMENT=local
LOG_LEVEL=INFO
# Human-readable logs locally; JSON (Cloud Logging format) everywhere else.
LOG_JSON=false

# --- data stores (docker compose defaults) ---------------------------------------------
DATABASE_URL=postgresql://moneymoney:moneymoney@localhost:5432/moneymoney
REDIS_URL=redis://localhost:6379/0

# --- web/session -----------------------------------------------------------------------
# Local dev runs on http://localhost, so the session cookie cannot be Secure.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
# Where the web app is served. Password reset emails link to <WEB_BASE_URL>/reset-password.
WEB_BASE_URL=http://localhost:3000

# --- password reset --------------------------------------------------------------------
# No email provider yet: outside production, reset emails (link included) are printed in
# the API log; in production they are not sent and the link is never logged.
# Reset requests per email address and per client IP, each per hour.
RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_PER_IP_PER_HOUR=20

# --- LLM -------------------------------------------------------------------------------
# "rules" = offline deterministic parser (no cloud needed).
# "gemini" = Gemini on Vertex AI via Application Default Credentials
#            (run: gcloud auth application-default login).
LLM_PROVIDER=rules
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
LLM_UNDERSTAND_MODEL=gemini-3.5-flash-lite
LLM_UNDERSTAND_THINKING=low
LLM_REPLY_MODEL=gemini-3.5-flash-lite
LLM_REPLY_THINKING=minimal
LLM_FALLBACK_TO_RULES=true

# Reject unsafe checkpoint payloads on load (state is plain JSON by design).
LANGGRAPH_STRICT_MSGPACK=true

# --- docker compose only -----------------------------------------------------------------
# Folder holding gcloud's Application Default Credentials, mounted read-only into the API
# container. Defaults to ~/.config/gcloud (macOS/Linux). On Windows use:
#   GCLOUD_CONFIG_DIR=C:/Users/<you>/AppData/Roaming/gcloud
# GCLOUD_CONFIG_DIR=
