# Copy to .env and adjust. Every variable maps to a field in backend/src/finance_core/config.py.

ENVIRONMENT=local
LOG_LEVEL=INFO
# Human-readable logs locally; JSON (Cloud Logging format) everywhere else.
LOG_JSON=false

# --- data stores (docker compose defaults) ---------------------------------------------
DATABASE_URL=postgresql://moneymoney:moneymoney@localhost:5432/moneymoney
REDIS_URL=redis://localhost:6379/0

# --- web/session -----------------------------------------------------------------------
# Local dev runs on http://localhost, so the session cookie cannot be Secure.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000

# --- LLM -------------------------------------------------------------------------------
# "rules" = offline deterministic parser (no cloud needed).
# "gemini" = Gemini on Vertex AI via Application Default Credentials
#            (run: gcloud auth application-default login).
LLM_PROVIDER=rules
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
LLM_UNDERSTAND_MODEL=gemini-3.5-flash-lite
LLM_UNDERSTAND_THINKING=low
LLM_REPLY_MODEL=gemini-3.5-flash-lite
LLM_REPLY_THINKING=minimal
LLM_FALLBACK_TO_RULES=true

# Reject unsafe checkpoint payloads on load (state is plain JSON by design).
LANGGRAPH_STRICT_MSGPACK=true
